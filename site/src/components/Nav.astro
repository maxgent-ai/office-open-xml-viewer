---
interface Props {
  active?: 'pptx' | 'docx' | 'xlsx' | 'announcements' | 'frameworks';
}
const { active } = Astro.props;
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="nav-brand" href="/">
      <span class="nav-wordmark">@silurus/ooxml</span>
    </a>
    <div class="nav-links">
      <a href="/announcements" class:list={['nav-news', { 'nav-on': active === 'announcements' }]}>Announcements</a>
      <a href="/docx" class:list={[{ 'nav-on': active === 'docx' }]}>DOCX</a>
      <a href="/xlsx" class:list={[{ 'nav-on': active === 'xlsx' }]}>XLSX</a>
      <a href="/pptx" class:list={[{ 'nav-on': active === 'pptx' }]}>PPTX</a>
      <a href="/try">Try yours</a>
      <a href="/frameworks" class:list={[{ 'nav-on': active === 'frameworks' }]}>Frameworks</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
        <span class="theme-glyph" aria-hidden="true"></span>
        <span class="theme-label" aria-hidden="true"></span>
      </button>
      <a class="nav-gh" href="https://github.com/yukiyokotani/office-open-xml-viewer">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.64 5.47 7.72.4.08.55-.18.55-.39 0-.19-.01-.83-.01-1.5-2.01.38-2.53-.5-2.69-.96-.09-.23-.48-.96-.82-1.15-.28-.15-.68-.54-.01-.55.63-.01 1.08.59 1.23.83.72 1.23 1.87.88 2.33.67.07-.53.28-.88.51-1.08-1.78-.21-3.64-.91-3.64-4.02 0-.89.31-1.62.82-2.19-.08-.2-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.45 7.45 0 0 1 8 3.9c.68 0 1.36.09 2 .27 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.96.08 2.16.51.57.82 1.3.82 2.19 0 3.12-1.87 3.81-3.65 4.02.29.25.54.73.54 1.49 0 1.08-.01 1.95-.01 2.22 0 .22.15.47.55.39A8.14 8.14 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z" />
        </svg>
        <span>GitHub &#x2197;&#xFE0E;</span>
      </a>
    </div>
  </div>
</nav>
