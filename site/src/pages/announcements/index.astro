---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import { announcements, formatAnnouncementDate } from '../../lib/announcements';
---
<Base
  title="Announcements — @silurus/ooxml"
  description="Release notices, migration guidance and important behavior changes for @silurus/ooxml."
  canonicalPath="/announcements/"
>
  <Nav active="announcements" />
  <main>
    <header class="news-hero">
      <div class="wrap news-hero-grid">
        <div>
          <p class="eyebrow">Product notices</p>
          <h1>Release notices and<br />migration guidance.</h1>
        </div>
        <p>
          Notices cover changes that may require integration updates. Routine fixes remain in
          the changelog.
        </p>
      </div>
    </header>

    <section class="wrap news-list" aria-label="Announcements">
      {announcements.map((item) => (
        <a class="news-row" href={`/announcements/${item.slug}`}>
          <span class="news-main">
            <span class="news-meta">
              <time datetime={item.date}>{formatAnnouncementDate(item.date)}</time>
              <span>{item.label}</span>
              {item.version && <span class="news-version">{item.version}</span>}
            </span>
            <strong>{item.title}</strong>
            <span class="news-summary">{item.summary}</span>
          </span>
          <span class="news-arrow" aria-hidden="true">&#x2197;&#xFE0E;</span>
        </a>
      ))}
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <BrandIcon />
        <div><strong>@silurus/ooxml</strong><span>Browser-based OOXML viewer · Rust/WASM + Canvas</span></div>
      </div>
      <div class="footer-links"><a href="/">Home</a><a href="https://github.com/yukiyokotani/office-open-xml-viewer">GitHub</a></div>
    </div>
  </footer>
</Base>

<style>
  .news-hero { padding: 100px 0 72px; background: var(--hero-bg); color: var(--hero-text); }
  .news-hero-grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 72px; align-items: end; }
  .news-hero .eyebrow { color: var(--hero-text); }
  .news-hero h1 { margin-top: 18px; font-size: clamp(44px, 7vw, 82px); letter-spacing: -0.055em; }
  .news-hero p:last-child { margin: 0; color: var(--hero-muted); font-size: 17px; }
  .news-list { padding-top: 40px; padding-bottom: 96px; }
  .news-row { display: grid; grid-template-columns: 1fr 32px; gap: 24px; padding: 32px 0; border-bottom: 1px solid var(--border); }
  .news-row:first-child { border-top: 1px solid var(--border); }
  .news-row:hover .news-arrow { transform: translate(3px, -3px); }
  .news-main { display: grid; gap: 10px; }
  .news-meta { display: flex; gap: 10px; flex-wrap: wrap; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--text-faint); }
  .news-version { color: var(--accent); }
  .news-main strong { font-size: clamp(22px, 3vw, 34px); letter-spacing: -.035em; line-height: 1.12; }
  .news-summary { max-width: 72ch; color: var(--text-dim); }
  .news-arrow { font-size: 20px; transition: transform .2s ease; }
  @media (max-width: 760px) {
    .news-hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .news-row { grid-template-columns: 1fr; gap: 12px; }
    .news-arrow { display: none; }
  }
</style>
